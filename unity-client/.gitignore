# This file follows Unity's own official gitignore template
# (github.com/github/gitignore/blob/main/Unity.gitignore), scoped to this
# subdirectory. Everything ignored here is regenerated automatically by
# the Editor on open/build -- never hand-authored, never worth diffing.

[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
[Rr]ecordings/
[Uu]ser[Ss]ettings/

# Never ship the Assembly info generated from the assembly definition files
[Aa]ssets/AssemblyInfo.cs

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Card art converted from ../web-static/img by tools/convert_card_art.py
# (regenerated on demand, not a second checked-in copy of the art)
/[Aa]ssets/[Rr]esources/CardArt/
/[Aa]ssets/[Rr]esources/CardArt.meta
/[Aa]ssets/[Rr]esources.meta

# Scratch output of the Android native build (CMake/Gradle), regenerated each build
/.utmp/

# Temporary scenes the Unity Test Framework creates during a run; it deletes
# them on completion, but an interrupted/timed-out run leaves them behind
/[Aa]ssets/InitTestScene*.unity
/[Aa]ssets/InitTestScene*.unity.meta
