{
    "name": "moodswings/php-app",
    "description": "PHP application for the MoodSwings-Web simulator",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "phpmailer/phpmailer": "^6.9",
        "minishlink/web-push": "^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "MoodSwings\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MoodSwings\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "migrate": "php bin/migrate.php"
    }
}
