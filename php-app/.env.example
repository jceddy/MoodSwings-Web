DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=moodswings
DB_USER=root
DB_PASSWORD=

# Public base URL the app is served at (no trailing slash), used to build
# links in emails, e.g. https://example.com/app if deployed under /app.
APP_URL=http://localhost:8000

# Optional: the site's own domain root (no trailing slash), used to build
# links back into the static frontend (e.g. the post-Discord-link redirect
# to /game/) -- distinct from APP_URL when the PHP app is deployed under a
# path prefix like /app. If unset, derived from APP_URL by stripping a
# trailing '/app'.
SITE_URL=http://localhost:8000

# Optional: the CLI-capable `php` binary GameService::launchTacticalBotSearchJob()/
# scheduleAutomatedTurnRecheck() exec() their background scripts (bin/
# run_bot_search.php, bin/recheck_automated_turn.php) with. Leave unset to
# use PHP_BINARY (the running request's own binary) -- correct under a
# real CLI context (this local dev setup, most CI), but WRONG under
# PHP-FPM (this app's own real request-serving SAPI on most hosts,
# including Bluehost/cPanel), where PHP_BINARY resolves to the FPM
# master's own binary instead of anything script-runnable, producing a
# confusing "declare(strict_types=1) must be the very first statement"
# error from an otherwise perfectly valid script. Set this to the
# account's own CLI binary path (e.g. a cPanel EasyApache path like
# /opt/cpanel/ea-php83/root/usr/bin/php -- found via `php -v`/`which php`
# over SSH, or cPanel's own MultiPHP Manager) if background bot searches
# never seem to complete -- see GameService::cliPhpBinary()'s own
# docblock.
PHP_CLI_BINARY=

# SMTP credentials used to send the email verification link at registration
# and the password reset link.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=MoodSwings

# VAPID keys for Web Push (browser push notifications, issue #108).
# Generate with: php -r 'require "vendor/autoload.php"; print_r((new
# Minishlink\WebPush\VAPID)::createVapidKeys());' or the web-push npm CLI.
# VAPID_SUBJECT must be a mailto: address or an https:// URL identifying
# who's sending the push, per the Web Push protocol.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# Discord account linking, Interactions Endpoint, and DM notifications
# (issue #232). From https://discord.com/developers/applications --
# Application ID and Public Key are on General Information, Client
# Secret on OAuth2 -> General, Bot Token on the Bot tab (used to send
# notification DMs -- see Discord\DiscordNotificationChannel). See
# "Discord" in README.md for the full setup checklist.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
